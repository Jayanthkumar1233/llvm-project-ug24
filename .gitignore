

#===-- uG24 toolchain ------------------------------------------------------===
# Build trees and installed toolchains: all reproducible from these sources.
/build-ug24/
/build-stage1/
/build-arm64/
/build-armhf/
/build-none-eabi/
/stage1/
/toolchain-arm64/
/toolchain-armhf/
/toolchain-none-eabi/
/sysroot-armhf/
/sysroot-none-eabi/

# Per-run output from compiling or simulating a test.
*.elf
*.dis
*.actual
ug24-memory.bin

# The simulator binary is built by ug24-setup.sh.
/ug24-sim/ug24sim

# Snapshot archives: the sources they hold are versioned here.
*.zip
*.tar.gz

# Compiler output left beside the uG24 test sources.  Scoped to those
# directories: .s and .ll are ordinary test inputs everywhere else in LLVM.
/ug24-tests/**/*.s
/ug24-tests/**/*.ll
/ug24-tests/**/*.o
/ug24-sim/**/*.s
/ug24-sim/**/*.ll
/ug24-sim/**/*.o
!/ug24-runtime/crt0.s
