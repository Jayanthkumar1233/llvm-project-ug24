	cd /home/basil-16/llvm-arm-cross/llvm-project/build-rt-m4/build-arm && $(MAKE) $(MAKESILENT) -f lib/xray/CMakeFiles/RTXray.armhf.dir/build.make lib/xray/CMakeFiles/RTXray.armhf.dir/xray_utils.cpp.i
.PHONY : xray_utils.cpp.i

xray_utils.s: xray_utils.cpp.s
.PHONY : xray_utils.s

# target to generate assembly for a file
xray_utils.cpp.s:
	cd /home/basil-16/llvm-arm-cross/llvm-project/build-rt-m4/build-arm && $(MAKE) $(MAKESILENT) -f lib/xray/CMakeFiles/RTXray.armhf.dir/build.make lib/xray/CMakeFiles/RTXray.armhf.dir/xray_utils.cpp.s
.PHONY : xray_utils.cpp.s

