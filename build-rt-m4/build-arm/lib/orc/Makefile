	@echo "... log_error_to_stderr.s"
	@echo "... run_program_wrapper.o"
	@echo "... run_program_wrapper.i"
	@echo "... run_program_wrapper.s"
.PHONY : help



#=============================================================================
# Special targets to cleanup operation of make.

# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	cd /home/basil-16/llvm-arm-cross/llvm-project/build-rt-m4/build-arm && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
.PHONY : cmake_check_build_system

